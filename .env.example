# Model
MODEL_ID=marksverdhei/Qwen3-Voice-Embedding-12Hz-1.7B
MODEL_REVISION=7577f61c42737fc8064bba773e2a18602df92803
DEVICE=auto                   # auto | cpu | cuda
# Only needed for private/gated models. Keep this line free of trailing
# comments: with an empty value python-dotenv would read the comment as the token.
HF_TOKEN=

# Server
HOST=0.0.0.0
PORT=6422

# Audio limits
MIN_AUDIO_SECONDS=1
MAX_AUDIO_SECONDS=0           # 0 = no cap (as in the HDSD manual); ~7.6 MiB of activations per second of audio
MAX_UPLOAD_MB=25

# Out-of-memory handling (the GPU may be shared with other jobs)
CPU_FALLBACK_ON_OOM=1         # after a CUDA OOM + retry, run the request on a CPU copy of the model
# Optional, passed straight to torch; the service does not set it itself.
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
LOG_LEVEL=INFO

# Verification
DEFAULT_THRESHOLD=0.96
# Storage
SPEAKER_DATA_DIR=data/speakers
CALIBRATION_PATH=calibration/mean_embedding.npy

# Offline / air-gapped deployment — set all three to 1 once the model
# revision above is cached locally (~/.cache/huggingface/hub/...)
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
